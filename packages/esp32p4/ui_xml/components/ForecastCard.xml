<component name="ForecastCard">
  <lv_image x="8" y="#icon_y" width="40" height="40" bind="forecast.icon" />
  <lv_label x="50" y="#high_y" width="44" height="24" font_size="#temperature_size" align="center" bind="forecast.high" />
  <lv_label x="50" y="#low_y" width="44" height="24" font_size="#temperature_size" align="center" bind="forecast.low" />
  <lv_obj x="12" y="#weather_rule_y" width="76" height="1" />
  <lv_label x="6" y="#weather_label_y" width="88" height="25" font_size="#weather_label_size" align="center" bind="forecast.label" />
  <lv_label x="4" y="#description_y" width="92" height="22" font_size="13" align="center" bind="forecast.description" />
</component>
