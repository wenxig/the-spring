menu "the-spring modem"

config SPRING_MODEM_USE_UART
    bool "Use UART DTE instead of USB"
    default n
    help
        Keep the UART DTE as an explicit compatibility path. The default is the
        EC600M USB dedicated AT bulk port.

config SPRING_MODEM_APN
    string "Cellular APN"
    default "CMNET"

config SPRING_MODEM_USB_VID
    hex "USB modem vendor ID"
    default 0x2C7C

config SPRING_MODEM_USB_PID
    hex "USB modem product ID"
    default 0x6002

config SPRING_MODEM_USB_AT_INTERFACE
    int "EC600M USB dedicated AT interface"
    default 3
    help
        EC600M accepts AT commands only on its dedicated vendor-specific bulk
        interface. This is the primary esp_modem terminal and must match the
        modem USB descriptor. Interface 3 is the validated default for
        EC600MCNLER06A08M08; set this to the descriptor's dedicated AT port
        when firmware exposes a different interface.

config SPRING_MODEM_USB_SECONDARY_INTERFACE
    int "EC600M USB secondary data interface"
    default -1
    help
        Optional secondary bulk data interface. Keep -1 when PPP shares
        the EC600M AT port; the AT interface remains the only control port.

endmenu
