menu "the-spring display"

config SPRING_DISPLAY_SPI_FREQUENCY_HZ
    int "Electronic-paper SPI frequency (Hz)"
    range 100000 20000000
    default 1000000

config SPRING_DISPLAY_BUSY_ACTIVE_HIGH
    bool "BUSY signal is active high"
    default y

config SPRING_DISPLAY_PARTIAL_REFRESH_LIMIT
    int "Partial refreshes before a full refresh"
    range 1 255
    default 20

config SPRING_DISPLAY_ENABLE_PARTIAL_REFRESH
    bool "Enable electronic-paper partial refresh"
    default n
    help
        Enable the SSD1683 partial-refresh command sequence. The
        QYEG0420BNS830 panel-specific waveform and update sequence still need
        to be verified on real hardware, so keep this disabled until that
        validation is complete. Disabled mode always sends a full refresh,
        which is slower but keeps the panel RAM and waveform state coherent.

endmenu
